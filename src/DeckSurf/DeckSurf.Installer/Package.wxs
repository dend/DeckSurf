<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- The UpgradeCode is DeckSurf's permanent installer identity; never
       change it, or upgrades stop replacing older installs. -->
  <Package
    Name="DeckSurf"
    Manufacturer="Den Delimarsky"
    Version="$(var.ProductVersion)"
    UpgradeCode="511420F0-F9EC-414B-A861-09596497C6B7"
    Scope="perMachine">

    <SummaryInformation Description="DeckSurf, the open Stream Deck manager for Windows." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of DeckSurf is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DeckSurfIcon" SourceFile="$(var.StagingDir)\Assets\piglet.ico" />
    <Property Id="ARPPRODUCTICON" Value="DeckSurfIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://den.dev" />
    <Property Id="ARPHELPLINK" Value="https://github.com/dend/DeckSurf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeckSurf" />
    </StandardDirectory>

    <!-- Everything the publish staged, app and plugins alike. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StagingDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut
          Id="DeckSurfShortcut"
          Name="DeckSurf"
          Description="Open Stream Deck manager"
          Target="[INSTALLFOLDER]DeckSurf.App.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Den.Dev\DeckSurf"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
