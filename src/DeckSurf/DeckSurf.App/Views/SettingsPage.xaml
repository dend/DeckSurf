<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,20,28,0">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False" Margin="0,0,0,8">
                <CommandBar.Content>
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </CommandBar.Content>
            </CommandBar>

            <tk:SettingsCard Header="App theme" Description="Changes apply immediately.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" Foreground="#FF9A6CFF" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeSelector" MinWidth="160" SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="Use system setting" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Profiles folder" Description="{x:Bind ProfilesPath}">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" Foreground="#FFFFC83D" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenProfilesFolder_Click" />
            </tk:SettingsCard>

            <tk:SettingsExpander
                Header="Plugin folders"
                Description="{x:Bind BuiltInPathsText}"
                IsExpanded="True"
                ItemsSource="{x:Bind CustomFolders}">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEA86;" Foreground="#FF00B7C3" />
                </tk:SettingsExpander.HeaderIcon>
                <Button Click="AddPluginFolder_Click" AutomationProperties.Name="Add plugin folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <tk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <tk:SettingsCard Header="{x:Bind}">
                            <Button Click="RemovePluginFolder_Click" ToolTipService.ToolTip="Remove folder" AutomationProperties.Name="Remove folder">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                        </tk:SettingsCard>
                    </DataTemplate>
                </tk:SettingsExpander.ItemTemplate>
            </tk:SettingsExpander>

            <tk:SettingsCard Header="DeckSurf" Description="{x:Bind AboutText}" Margin="0,16,0,0">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" Foreground="#FF60CDFF" />
                </tk:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dend/decksurf" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
