<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:DeckSurf.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,20,28,0">
        <StackPanel Spacing="24" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>

            <!-- Collapsed by default so the closed bar consumes zero layout space,
                 including the group spacing slots on both sides; ShowPageError and
                 PageInfoBar_Closed keep Visibility in lockstep with IsOpen. -->
            <InfoBar
                x:Name="PageInfoBar"
                Title="Setting could not be applied"
                Severity="Error"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed"
                Closed="PageInfoBar_Closed" />

            <StackPanel Spacing="4">
                <tk:SettingsCard Header="App theme" Description="Changes apply immediately.">
                    <ComboBox x:Name="ThemeSelector" MinWidth="160" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Profiles folder" Description="{x:Bind ProfilesPath}">
                    <Button Content="Open" Click="OpenProfilesFolder_Click" />
                </tk:SettingsCard>

                <tk:SettingsExpander
                    Header="Plugin folders"
                    Description="Folders scanned for DeckSurf plugin assemblies."
                    IsExpanded="True"
                    ItemsSource="{x:Bind FolderRows}">
                    <Button Content="Add folder" Click="AddPluginFolder_Click" AutomationProperties.Name="Add plugin folder" />
                    <tk:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="views:PluginFolderRow">
                            <!-- The path is the row's identity; immutability reads as a
                                 pill instead of prose, and only custom folders offer
                                 an action. -->
                            <tk:SettingsCard Header="{x:Bind Path}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2,8,3"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind BuiltInVisibility}">
                                        <TextBlock
                                            Text="Built-in"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Button Content="Remove" Click="RemovePluginFolder_Click" Visibility="{x:Bind RemoveVisibility}" AutomationProperties.Name="Remove folder" />
                                </StackPanel>
                            </tk:SettingsCard>
                        </DataTemplate>
                    </tk:SettingsExpander.ItemTemplate>
                </tk:SettingsExpander>

                <!-- About sits in the same card rhythm as everything else; a
                     larger gap here read as a mistake, not a grouping. -->
                <tk:SettingsExpander IsExpanded="True">
                    <tk:SettingsExpander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/piglet.ico" Width="20" Height="20" />
                            <TextBlock Text="DeckSurf" VerticalAlignment="Center" />
                            <!-- The state of the software, said plainly and visibly. -->
                            <Border
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                Padding="8,2,8,3"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="BETA"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </tk:SettingsExpander.Header>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="App" Description="{x:Bind AppVersionText}">
                            <TextBlock
                                Text="{x:Bind BuildStampText}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                VerticalAlignment="Center" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="SDK" Description="{x:Bind SdkVersionText}">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dend/decksurf-sdk" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Created by" Description="Den Delimarsky">
                            <HyperlinkButton Content="den.dev" NavigateUri="https://den.dev" ToolTipService.ToolTip="Den Delimarsky's website" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
