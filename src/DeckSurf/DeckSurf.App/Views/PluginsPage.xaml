<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24,24,24,0">
        <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Left" Margin="0,0,0,24">
            <Grid>
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.OpenPluginsFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Open plugins folder" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,48,0,0"
                MaxWidth="420"
                Visibility="{x:Bind ViewModel.HasNoPlugins}">
                <FontIcon Glyph="&#xEA86;" FontSize="44" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasDiagnostics}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:PluginInfo">
                        <StackPanel Spacing="4" Margin="0,0,0,20">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{x:Bind Commands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:CommandInfo">
                                        <tk:SettingsCard
                                            Header="{x:Bind DisplayName}"
                                            Description="{x:Bind Description}"
                                            Margin="0,0,0,4">
                                            <tk:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE945;" />
                                            </tk:SettingsCard.HeaderIcon>
                                            <StackPanel Spacing="6" HorizontalAlignment="Right">
                                                <ItemsControl ItemsSource="{x:Bind ModelChips}" HorizontalAlignment="Right">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2">
                                                                <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.9" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{x:Bind ParametersText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </tk:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
