<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,20,28,0">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False" Margin="0,0,0,8">
                <CommandBar.Content>
                    <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </CommandBar.Content>
                <AppBarButton Label="Refresh" Command="{x:Bind ViewModel.RescanCommand}" ToolTipService.ToolTip="Scan all plugin folders again">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Plugin folder" Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" ToolTipService.ToolTip="Open the built-in plugin folder">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,64,0,0"
                MaxWidth="420"
                Visibility="{x:Bind ViewModel.HasNoPlugins, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/puzzle_piece.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:PluginInfo">
                        <tk:SettingsExpander
                            Header="{x:Bind DisplayName}"
                            Description="{x:Bind Subtitle}"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Commands}"
                            Margin="0,0,0,8">
                            <tk:SettingsExpander.HeaderIcon>
                                <ImageIcon Source="ms-appx:///Assets/Icons/puzzle_piece.png" />
                            </tk:SettingsExpander.HeaderIcon>
                            <tk:SettingsExpander.ItemTemplate>
                                <DataTemplate x:DataType="services:CommandInfo">
                                    <tk:SettingsCard
                                        Header="{x:Bind DisplayName}"
                                        Description="{x:Bind Description}">
                                        <Button Content="Details">
                                            <Button.Flyout>
                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                    <StackPanel Spacing="14" Width="360">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                                        </StackPanel>

                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Supported devices" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                                            <ItemsControl ItemsSource="{x:Bind ModelChips}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                                                            <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <StackPanel Spacing="8" Visibility="{x:Bind HasParameters}">
                                                            <TextBlock Text="Settings" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                                            <ItemsControl ItemsSource="{x:Bind ParameterRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="services:ParameterRow">
                                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                                                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <TextBlock Text="This command has no settings." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" Visibility="{x:Bind HasNoParameters}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </tk:SettingsCard>
                                </DataTemplate>
                            </tk:SettingsExpander.ItemTemplate>
                        </tk:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
