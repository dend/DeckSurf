<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RescanCommand}" ToolTipService.ToolTip="Scan all plugin folders again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" ToolTipService.ToolTip="Open the built-in plugin folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Plugin folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}"
                Margin="0,0,0,24" />

            <!-- The Windows Settings pattern: one clickable row per plugin, its
                 commands living on a sub-page reached through the row and headed
                 by a breadcrumb. Scales past a handful of plugins. -->
            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasPlugins, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PluginInfo">
                            <tk:SettingsCard
                                Header="{x:Bind DisplayName}"
                                Description="{x:Bind Author}"
                                IsClickEnabled="True"
                                Click="PluginRow_Click"
                                ToolTipService.ToolTip="{x:Bind HeaderToolTip}">
                                <TextBlock
                                    Text="{x:Bind CommandCountText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </tk:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoPlugins, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/puzzle_piece.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Open plugin folder"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
