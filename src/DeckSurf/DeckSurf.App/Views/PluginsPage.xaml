<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>

        <!-- =====================================================================
             Command tile: Windows Settings-homepage card grammar. Every command is
             one 116px clickable tile; its spec sheet lives in a flyout, so details
             cost zero vertical pixels.
             Known WinUI limitation, accepted: ThemeResource values inside VSM
             setters do not re-resolve during a live theme switch while the state is
             active. Only the transient PointerOver/Pressed states are affected; the
             Normal background comes from the TemplateBinding and stays correct.
             ===================================================================== -->
        <Style x:Key="CommandTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Height" Value="116" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                            <Setter Target="Presenter.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Presenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one chip: neutral fill, caption secondary text, radius 4, no border.
             A chip renders only when compatibility is restricted; silence means
             universal. -->
        <DataTemplate x:Key="DeviceChipTemplate" x:DataType="x:String">
            <Border
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="8,2"
                VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalChipsPanel">
            <StackPanel Orientation="Horizontal" Spacing="8" />
        </ItemsPanelTemplate>

        <!-- Choice value chip; the default value is marked in words: "value (default)".
             Same neutral colorway as every other chip. -->
        <DataTemplate x:Key="ChoiceChipTemplate" x:DataType="services:ChoiceChip">
            <Border
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="8,2">
                <TextBlock
                    Text="{x:Bind DisplayLabel}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <!-- One parameter = one spec block: name + type/required badges, choice
             chips, default badge, help text. Every block opens with a hairline top
             rule; under the flyout header the first rule doubles, deliberately, as
             the header separator. -->
        <DataTemplate x:Key="ParameterBlockTemplate" x:DataType="services:ParameterRow">
            <StackPanel
                Padding="16"
                Spacing="8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Name}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="8,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind TypeLabel}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        Visibility="{x:Bind IsRequired}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="8,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Required"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>
                <ItemsRepeater
                    Visibility="{x:Bind HasChoices}"
                    ItemsSource="{x:Bind ChoiceChips}"
                    ItemTemplate="{StaticResource ChoiceChipTemplate}"
                    AutomationProperties.Name="Choices">
                    <ItemsRepeater.Layout>
                        <LinedFlowLayout ItemsStretch="None" ItemsJustification="Start" MinItemSpacing="8" LineSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock
                    Visibility="{x:Bind HasStandaloneDefault}"
                    Text="{x:Bind DefaultBadge}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Visibility="{x:Bind HasDescription}"
                    Text="{x:Bind Description}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- Command tile: ONE variant for every command. Parameterized commands get
             the spec sheet; the rest get full description + devices + a quiet
             "no settings" row, so clicking is never a dead end, every command is
             keyboard-focusable, and truncated tile text is always reachable
             without hover. -->
        <DataTemplate x:Key="CommandTileTemplate" x:DataType="services:CommandInfo">
            <Button
                Style="{StaticResource CommandTileStyle}"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ToolTipService.ToolTip="{x:Bind DescriptionToolTip}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind DisplayName}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Description}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Top" />
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- TileChips caps at 2 chips + a "+N" overflow chip and is
                             empty for universal commands; the tooltip and the flyout
                             carry the full device list. -->
                        <ItemsControl
                            ItemsSource="{x:Bind TileChips}"
                            ItemTemplate="{StaticResource DeviceChipTemplate}"
                            ItemsPanel="{StaticResource HorizontalChipsPanel}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind DevicesToolTip}"
                            AutomationProperties.Name="Supported devices" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind SettingsSummary}"
                            Visibility="{x:Bind HasParameters}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="No settings"
                            Visibility="{x:Bind HasNoParameters}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Flyout.FlyoutPresenterStyle>
                            <!-- Property-only restyle: the presenter keeps its
                                 built-in template, ScrollViewer, background and
                                 shadow, so long schemas scroll natively. -->
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="380" />
                                <Setter Property="MaxWidth" Value="480" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel>
                            <StackPanel Padding="16" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind DisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    Visibility="{x:Bind HasDescription}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <ItemsRepeater
                                    Visibility="{x:Bind HasModelChips}"
                                    ItemsSource="{x:Bind ModelChips}"
                                    ItemTemplate="{StaticResource DeviceChipTemplate}"
                                    AutomationProperties.Name="Supported devices">
                                    <ItemsRepeater.Layout>
                                        <LinedFlowLayout ItemsStretch="None" ItemsJustification="Start" MinItemSpacing="8" LineSpacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                            <ItemsControl
                                ItemsSource="{x:Bind ParameterRows}"
                                ItemTemplate="{StaticResource ParameterBlockTemplate}"
                                Visibility="{x:Bind HasParameters}" />
                            <StackPanel
                                Visibility="{x:Bind HasNoParameters}"
                                Padding="16"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock
                                    Text="No settings. This command runs as-is."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,0">
        <Grid Width="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RescanCommand}" ToolTipService.ToolTip="Scan all plugin folders again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" ToolTipService.ToolTip="Open the built-in plugin folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Plugin folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}"
                Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasPlugins, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PluginInfo">
                            <!-- One plugin = single-line section head + a 4-column tile
                                 grid: 4 x 236 + 3 x 8 = 968, so four columns hold even
                                 when a reserved scrollbar narrows the viewport, and
                                 ItemsStretch=Fill runs the tiles out to the rail. -->
                            <StackPanel Margin="0,0,0,24">
                                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Subtitle}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,2"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Subtitle}" />
                                </Grid>
                                <ItemsRepeater
                                    ItemsSource="{x:Bind Commands}"
                                    ItemTemplate="{StaticResource CommandTileTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            Orientation="Horizontal"
                                            MinItemWidth="236"
                                            MinItemHeight="116"
                                            MinColumnSpacing="8"
                                            MinRowSpacing="8"
                                            ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoPlugins, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/puzzle_piece.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Open plugin folder"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
