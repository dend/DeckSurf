<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Neutral device chip: control fill + secondary text = metadata, not action. -->
        <DataTemplate x:Key="DeviceChipTemplate" x:DataType="x:String">
            <Border
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,2"
                VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalChipsPanel">
            <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <ScrollViewer Padding="28,20,28,0">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False" Margin="0,0,0,8">
                <CommandBar.Content>
                    <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </CommandBar.Content>
                <AppBarButton Label="Refresh" Command="{x:Bind ViewModel.RescanCommand}" ToolTipService.ToolTip="Scan all plugin folders again">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Plugin folder" Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" ToolTipService.ToolTip="Open the built-in plugin folder">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,64,0,0"
                MaxWidth="420"
                Visibility="{x:Bind ViewModel.HasNoPlugins, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/puzzle_piece.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:PluginInfo">
                        <!-- One plugin = one Settings-style section: text header + tight card stack. -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock
                                Text="{x:Bind DisplayName}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Margin="1,8,0,0" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Margin="1,2,0,8" />

                            <ItemsControl ItemsSource="{x:Bind Commands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:CommandInfo">
                                        <Grid>
                                            <!-- No settings: a flat card. No chevron, no button, nothing to open. -->
                                            <tk:SettingsCard
                                                Header="{x:Bind DisplayName}"
                                                Description="{x:Bind Description}"
                                                Visibility="{x:Bind HasNoParameters}">
                                                <ItemsControl
                                                    ItemsSource="{x:Bind ModelChips}"
                                                    ItemTemplate="{StaticResource DeviceChipTemplate}"
                                                    ItemsPanel="{StaticResource HorizontalChipsPanel}"
                                                    ToolTipService.ToolTip="Supported devices"
                                                    AutomationProperties.Name="Supported devices" />
                                            </tk:SettingsCard>

                                            <!-- Has settings: the row itself expands, PowerToys-style. -->
                                            <tk:SettingsExpander
                                                Header="{x:Bind DisplayName}"
                                                Description="{x:Bind Description}"
                                                Visibility="{x:Bind HasParameters}"
                                                ItemsSource="{x:Bind ParameterRows}"
                                                HorizontalAlignment="Stretch">
                                                <tk:SettingsExpander.Content>
                                                    <ItemsControl
                                                        ItemsSource="{x:Bind ModelChips}"
                                                        ItemTemplate="{StaticResource DeviceChipTemplate}"
                                                        ItemsPanel="{StaticResource HorizontalChipsPanel}"
                                                        ToolTipService.ToolTip="Supported devices"
                                                        AutomationProperties.Name="Supported devices" />
                                                </tk:SettingsExpander.Content>
                                                <tk:SettingsExpander.ItemTemplate>
                                                    <DataTemplate x:DataType="services:ParameterRow">
                                                        <!-- Name left, help text under it, type/default as the right-hand value.
                                                             Local Padding overrides the toolkit's 58px icon indent so parameter
                                                             names align flush with the command name above. -->
                                                        <tk:SettingsCard
                                                            Header="{x:Bind Name}"
                                                            Description="{x:Bind Description}"
                                                            Padding="16,8,16,8">
                                                            <TextBlock
                                                                Text="{x:Bind Meta}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                TextWrapping="Wrap"
                                                                TextAlignment="Right"
                                                                MaxWidth="280"
                                                                VerticalAlignment="Center" />
                                                        </tk:SettingsCard>
                                                    </DataTemplate>
                                                </tk:SettingsExpander.ItemTemplate>
                                            </tk:SettingsExpander>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
