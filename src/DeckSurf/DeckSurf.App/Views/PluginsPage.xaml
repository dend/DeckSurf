<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>

        <!-- =====================================================================
             Command tile: the Gallery tile anatomy with the key cap as the identity
             container. Every command is one clickable tile whose detail lives in a
             flyout sharing the same grammar.
             Known WinUI limitation, accepted: ThemeResource values inside VSM
             setters do not re-resolve during a live theme switch while the state is
             active. Only the transient PointerOver/Pressed states are affected; the
             Normal background comes from the TemplateBinding and stays correct.
             ===================================================================== -->
        <Style x:Key="CommandTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <!-- 112, not the spec's 108: that budget was an exact fit
                 (16+20+4+32+4+16+16) and DPI rounding stole the description's
                 second line. 4px of slack preserves the two-line intent. -->
            <Setter Property="Padding" Value="16" />
            <Setter Property="Height" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                            <Setter Target="Presenter.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Presenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command tile: one variant for every command. The 44px key cap carries
             identity: author-declared artwork when the plugin ships an icon, else
             the command's monogram lit in the user's accent, the backlit legend of
             a powered key awaiting art. The footer compatibility line is always
             populated; silence never encodes meaning. -->
        <DataTemplate x:Key="CommandTileTemplate" x:DataType="services:CommandInfo">
            <Button
                Style="{StaticResource CommandTileStyle}"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ToolTipService.ToolTip="{x:Bind DescriptionToolTip}">
                <Grid ColumnSpacing="8" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="2" Width="44" Height="44" CornerRadius="8" Background="{ThemeResource DeckKeyBrush}" VerticalAlignment="Top">
                        <Image Width="28" Height="28" Stretch="Uniform" Visibility="{x:Bind HasIcon}">
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind IconUri}" DecodePixelWidth="56" />
                            </Image.Source>
                        </Image>
                        <TextBlock
                            Text="{x:Bind Monogram}"
                            Visibility="{x:Bind HasNoIcon}"
                            Foreground="{StaticResource DeckMonogramBrush}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            CharacterSpacing="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind DisplayName}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{x:Bind Description}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Top" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Text="{x:Bind CompatibilityText}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="{x:Bind DevicesToolTip}" />
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="16" />
                                <Setter Property="MinWidth" Value="360" />
                                <Setter Property="MaxWidth" Value="420" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <!-- The detail surface shares the app's one grammar: the same
                             key cap that was clicked, fact blocks like the Devices
                             card, and parameter previews mirroring the editor form.
                             Hierarchy is type and spacing; no rules, no badges. -->
                        <StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44" CornerRadius="8" Background="{ThemeResource DeckKeyBrush}">
                                    <Image Width="28" Height="28" Stretch="Uniform" Visibility="{x:Bind HasIcon}">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind IconUri}" DecodePixelWidth="56" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock
                                        Text="{x:Bind Monogram}"
                                        Visibility="{x:Bind HasNoIcon}"
                                        Foreground="{StaticResource DeckMonogramBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        CharacterSpacing="50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind PluginName}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Text="{x:Bind Description}"
                                Visibility="{x:Bind HasDescription}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,16,0,0" />

                            <StackPanel Spacing="2" Margin="0,16,0,0">
                                <TextBlock Text="Works with" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind CompatibilityFull}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="Settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="No settings. This command runs as-is."
                                    Visibility="{x:Bind HasNoParameters}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ParameterRows}" Visibility="{x:Bind HasParameters}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ParameterRow">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind OptionsLine}" Visibility="{x:Bind HasOptions}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RescanCommand}" ToolTipService.ToolTip="Scan all plugin folders again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" ToolTipService.ToolTip="Open the built-in plugin folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Plugin folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Some plugins failed to load"
                Message="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}"
                Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasPlugins, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PluginInfo">
                            <StackPanel Margin="0,0,0,24">
                                <Grid ColumnSpacing="8" Margin="0,0,0,8" ToolTipService.ToolTip="{x:Bind HeaderToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Subtitle}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,2"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ItemsRepeater
                                    ItemsSource="{x:Bind Commands}"
                                    ItemTemplate="{StaticResource CommandTileTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            Orientation="Horizontal"
                                            MinItemWidth="236"
                                            MinItemHeight="112"
                                            MinColumnSpacing="8"
                                            MinRowSpacing="8"
                                            ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoPlugins, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/puzzle_piece.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No plugins found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Place plugin folders inside the plugins directory next to the application. Plugin assemblies follow the DeckSurf.Plugin.*.dll naming convention."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Open plugin folder"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.OpenPluginsFolderCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
