<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Title="Device operation failed"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}" Margin="0,0,0,24">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            Orientation="Horizontal"
                            MinItemWidth="560"
                            MinColumnSpacing="8"
                            MinRowSpacing="8"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <!-- One device = one card with the hardware as the hero: a
                                 miniature of the real layout (keys, screen, knobs)
                                 scaled to command the hero region on every model, with
                                 identity, facts, and controls grounded below. -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Background="{ThemeResource DeckFaceBrush}" CornerRadius="8,8,0,0" Padding="24" Height="200">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Nested ItemsControls, not ItemsRepeater: each cell
                                                 template binds its own KeyCellViewModel geometry,
                                                 which is what makes per-device pitch compile. -->
                                            <ItemsControl ItemsSource="{x:Bind KeyRows}" HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:KeyRowViewModel">
                                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:KeyCellViewModel">
                                                                    <Border Width="{x:Bind Size}" Height="{x:Bind Size}" CornerRadius="{x:Bind Corner}" Background="{ThemeResource DeckKeyBrush}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- The screen row always spans exactly the key grid's
                                                 width; on touch-key devices two 14px caps flank a
                                                 shortened strip (14 + 8 + strip + 8 + 14). -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind HasScreen}">
                                                <Border Width="14" Height="14" CornerRadius="4" Background="{ThemeResource DeckKeyBrush}" Visibility="{x:Bind HasTouchKeys}" />
                                                <Border
                                                    Height="14"
                                                    Width="{x:Bind ScreenStripWidth}"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource DeckKeyBrush}" />
                                                <Border Width="14" Height="14" CornerRadius="4" Background="{ThemeResource DeckKeyBrush}" Visibility="{x:Bind HasTouchKeys}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{x:Bind KnobCells}" HorizontalAlignment="Center" Visibility="{x:Bind HasKnobs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Int32">
                                                        <Ellipse Width="18" Height="18" Fill="{ThemeResource DeckKeyBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1" Padding="16">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" />

                                        <!-- Facts row: label over value, only what a user scans
                                             for. The miniature above shows the layout itself. -->
                                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,16,0,0">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Serial" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Serial}" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Keys" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind KeyCountText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Spacing="2" Visibility="{x:Bind HasKnobs}">
                                                <TextBlock Text="Knobs" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind KnobCountText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Spacing="2" Visibility="{x:Bind HasTouchKeys}">
                                                <TextBlock Text="Touch keys" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind TouchKeyCountText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Spacing="2" Margin="0,16,0,0">
                                            <TextBlock Text="Brightness" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- x:Bind, not Binding: ItemsRepeater does not flow
                                                     DataContext to its realized templates. The view
                                                     model applies value changes to the device. -->
                                                <Slider
                                                    Minimum="0"
                                                    Maximum="100"
                                                    StepFrequency="5"
                                                    Value="{x:Bind Brightness, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="Brightness, applies immediately"
                                                    AutomationProperties.Name="Brightness"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind BrightnessText, Mode=OneWay}"
                                                    MinWidth="40"
                                                    TextAlignment="Right"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Grid.Column="2"
                                                    Content="Flash keys"
                                                    Command="{x:Bind IdentifyCommand}"
                                                    ToolTipService.ToolTip="Flashes all keys white so you can tell devices apart"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/control_knobs.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No Stream Deck found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Connect a device over USB. If one is already connected, close the Elgato Stream Deck software, which holds exclusive access to the device."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Scan again"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
