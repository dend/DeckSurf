<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24" ColumnSpacing="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh device list">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="420"
            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
            <FontIcon Glyph="&#xE772;" FontSize="44" Opacity="0.35" HorizontalAlignment="Center" />
            <TextBlock Text="No Stream Deck found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="Connect a device over USB. If one is already connected, close the Elgato Stream Deck software — it holds exclusive access."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap"
                TextAlignment="Center" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{x:Bind ViewModel.Devices}"
            SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
            SelectionMode="Single"
            Margin="-12,0,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:DeviceSummary">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE772;" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatIdentity(Model, Serial)}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Severity="Error"
                    IsClosable="False"
                    Title="Device operation failed"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Margin="0,0,0,8" />

                <tk:SettingsCard Header="Model" Description="{x:Bind ViewModel.SelectedDevice.Serial, Mode=OneWay, FallbackValue=''}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE772;" />
                    </tk:SettingsCard.HeaderIcon>
                    <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatModel(ViewModel.SelectedDevice), Mode=OneWay}" Opacity="0.85" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Layout" Description="{x:Bind vm:DevicesViewModel.FormatExtras(ViewModel.SelectedDevice), Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </tk:SettingsCard.HeaderIcon>
                    <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatLayout(ViewModel.SelectedDevice), Mode=OneWay}" Opacity="0.85" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Brightness" Description="Applies immediately to the device backlight.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Slider
                            Width="220"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="5"
                            Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}"
                            ValueChanged="BrightnessSlider_ValueChanged" />
                        <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatBrightness(ViewModel.Brightness), Mode=OneWay}" VerticalAlignment="Center" MinWidth="40" />
                    </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Identify" Description="Flashes all keys white so you can tell devices apart.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button Content="Flash keys" Command="{x:Bind ViewModel.IdentifyCommand}" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
