<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Title="Device operation failed"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Items}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <tk:SettingsExpander
                                Header="{x:Bind Name}"
                                Description="{x:Bind Subtitle}"
                                IsExpanded="True"
                                HorizontalAlignment="Stretch">
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard Header="Brightness" Description="Applies immediately to the device backlight.">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Slider
                                                Width="220"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="5"
                                                Value="{Binding Brightness, Mode=TwoWay}"
                                                ValueChanged="BrightnessSlider_ValueChanged" />
                                            <TextBlock Text="{Binding BrightnessText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                        </StackPanel>
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="Identify" Description="Flashes all keys white so you can tell devices apart.">
                                        <Button Content="Flash keys" Command="{x:Bind IdentifyCommand}" />
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/control_knobs.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No Stream Deck found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Connect a device over USB. If one is already connected, close the Elgato Stream Deck software, which holds exclusive access to the device."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Scan again"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
