<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeckSurf.App.Services"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <Grid>
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh device list">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False"
                Title="No Stream Deck devices found"
                Message="Connect a device and make sure the Elgato Stream Deck software is closed — it holds exclusive USB access." />

            <ListView
                ItemsSource="{x:Bind ViewModel.Devices}"
                SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:DeviceSummary">
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE772;" FontSize="24" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatIdentity(Model, Serial)}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}" Style="{StaticResource SubtitleTextBlockStyle}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Title="Device operation failed"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Grid ColumnSpacing="24" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Opacity="0.7" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind vm:DevicesViewModel.FormatModel(ViewModel.SelectedDevice), Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.Serial, Mode=OneWay, FallbackValue=''}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Keys" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind vm:DevicesViewModel.FormatLayout(ViewModel.SelectedDevice), Mode=OneWay}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Extras" Opacity="0.7" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind vm:DevicesViewModel.FormatExtras(ViewModel.SelectedDevice), Mode=OneWay}" />
            </Grid>

            <TextBlock Text="Brightness" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Slider
                    Width="280"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="5"
                    Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}"
                    ValueChanged="BrightnessSlider_ValueChanged" />
                <TextBlock Text="{x:Bind vm:DevicesViewModel.FormatBrightness(ViewModel.Brightness), Mode=OneWay}" VerticalAlignment="Center" MinWidth="32" />
            </StackPanel>

            <Button Content="Identify device" Command="{x:Bind ViewModel.IdentifyCommand}" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Page>
