<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Title="Device operation failed"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}" Margin="0,0,0,24">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            Orientation="Horizontal"
                            MinItemWidth="360"
                            MinColumnSpacing="12"
                            MinRowSpacing="12"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <!-- One device = one compact card, gallery style: identity
                                 and enablement up top, the active profile as the
                                 centerpiece, brightness below, serial as a footnote. -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Padding="20,16,20,16">
                                <StackPanel Spacing="16">
                                    <!-- Identity row: name left, the enable switch right.
                                         Off means the runtime leaves the device alone; the
                                         connection stays. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                            OnContent=""
                                            OffContent=""
                                            MinWidth="0"
                                            Margin="0,0,-12,0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="On runs the device's active profile, off leaves the device alone and hides it from the editor"
                                            AutomationProperties.Name="Device enabled" />
                                    </Grid>

                                    <!-- The active profile is the card's working control:
                                         picking one switches the device right here. The dot
                                         reports whether it is live on the hardware. -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Profile" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnSpacing="10" Visibility="{x:Bind HasProfiles, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="8" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorNeutralBrush}" Visibility="{x:Bind IsNotRunning, Mode=OneWay}" />
                                            </Grid>
                                            <ComboBox
                                                Grid.Column="1"
                                                ItemsSource="{x:Bind ProfileNames}"
                                                SelectedItem="{x:Bind SelectedProfileName, Mode=TwoWay}"
                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                PlaceholderText="Choose a profile"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Active profile" />
                                        </Grid>
                                        <TextBlock
                                            Text="No profiles for this device yet. Create one in the editor."
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind HasNoProfiles, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Brightness" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- x:Bind, not Binding: ItemsRepeater does not flow
                                                 DataContext to its realized templates. The view
                                                 model applies value changes to the device. -->
                                            <Slider
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="5"
                                                Value="{x:Bind Brightness, Mode=TwoWay}"
                                                ToolTipService.ToolTip="Brightness, applies immediately"
                                                AutomationProperties.Name="Brightness"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind BrightnessText, Mode=OneWay}"
                                                MinWidth="40"
                                                TextAlignment="Right"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="2"
                                                Content="Flash keys"
                                                Command="{x:Bind IdentifyCommand}"
                                                ToolTipService.ToolTip="Flashes all keys white so you can tell devices apart"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Serial" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Serial}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Spacing="8"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Icons/control_knobs.png" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="No Stream Deck found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Connect a device over USB. If one is already connected, close the Elgato Stream Deck software, which holds exclusive access to the device."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Scan again"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
