<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,20,28,0">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False" Margin="0,0,0,8">
                <CommandBar.Content>
                    <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </CommandBar.Content>
                <AppBarButton Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <!-- Empty state -->
            <StackPanel
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,64,0,0"
                MaxWidth="420"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                <FontIcon Glyph="&#xE772;" FontSize="44" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="No Stream Deck found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Connect a device over USB. If one is already connected, close the Elgato Stream Deck software — it holds exclusive access."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItemViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                            <InfoBar
                                IsOpen="{Binding HasStatus, Mode=OneWay}"
                                Severity="Error"
                                IsClosable="False"
                                Title="Device operation failed"
                                Message="{Binding StatusMessage, Mode=OneWay}" />

                            <tk:SettingsExpander
                                Header="{x:Bind Name}"
                                Description="{x:Bind Subtitle}"
                                IsExpanded="True"
                                HorizontalAlignment="Stretch">
                                <tk:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE772;" />
                                </tk:SettingsExpander.HeaderIcon>

                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard Header="Layout" Description="{x:Bind LayoutText}">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xF0E2;" />
                                        </tk:SettingsCard.HeaderIcon>
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="Brightness" Description="Applies immediately to the device backlight.">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE706;" />
                                        </tk:SettingsCard.HeaderIcon>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Slider
                                                Width="220"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="5"
                                                Value="{Binding Brightness, Mode=TwoWay}"
                                                ValueChanged="BrightnessSlider_ValueChanged" />
                                            <TextBlock Text="{Binding BrightnessText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="40" />
                                        </StackPanel>
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="Identify" Description="Flashes all keys white so you can tell devices apart.">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE945;" />
                                        </tk:SettingsCard.HeaderIcon>
                                        <Button Content="Flash keys" Command="{x:Bind IdentifyCommand}" />
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
