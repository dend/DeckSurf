<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeckSurf.App.Controls"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <DataTemplate x:Key="KeyTileTemplate" x:DataType="vm:KeyViewModel">
            <Grid Width="86" Height="86" CornerRadius="8" Background="#FF2B2B2B" BorderBrush="#FF3D3D3D" BorderThickness="1">
                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Width="86" Height="86" Stretch="UniformToFill" />
                <TextBlock
                    Text="{x:Bind Label, Mode=OneWay}"
                    Foreground="#FFE8E8E8"
                    FontSize="11"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    Margin="6,18,6,6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                <Border Background="#66000000" CornerRadius="4" Padding="5,1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                    <TextBlock Text="{x:Bind IndexLabel}" FontSize="10" Foreground="#B3FFFFFF" />
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="KeyTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <!-- Match the tile corner radius so hover and selection chrome follows the shape. -->
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ParameterTextTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <TextBox
                    Header="{x:Bind HeaderText}"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterNumberTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <NumberBox
                    Header="{x:Bind HeaderText}"
                    Minimum="{x:Bind Minimum}"
                    Maximum="{x:Bind Maximum}"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    Value="{Binding NumberValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterBooleanTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <ToggleSwitch
                    Header="{x:Bind HeaderText}"
                    IsOn="{Binding BoolValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterChoiceTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <ComboBox
                    Header="{x:Bind HeaderText}"
                    PlaceholderText="Select…"
                    ItemsSource="{x:Bind Choices}"
                    SelectedItem="{Binding Value, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterFileTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <TextBlock Text="{x:Bind HeaderText}" Style="{StaticResource BodyTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse" Click="BrowseParameterFile_Click" />
                </Grid>
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <controls:ParameterTemplateSelector
            x:Key="ParameterTemplates"
            TextTemplate="{StaticResource ParameterTextTemplate}"
            NumberTemplate="{StaticResource ParameterNumberTemplate}"
            BooleanTemplate="{StaticResource ParameterBooleanTemplate}"
            ChoiceTemplate="{StaticResource ParameterChoiceTemplate}"
            FileTemplate="{StaticResource ParameterFileTemplate}"
            ImageTemplate="{StaticResource ParameterFileTemplate}" />
    </Page.Resources>

    <Grid Padding="28,16,28,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox
                        MinWidth="180"
                        VerticalAlignment="Center"
                        PlaceholderText="Select a profile"
                        ItemsSource="{x:Bind ViewModel.ProfileNames}"
                        SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />
                    <ComboBox
                        MinWidth="220"
                        VerticalAlignment="Center"
                        PlaceholderText="Device"
                        ToolTipService.ToolTip="Device this profile targets"
                        ItemsSource="{x:Bind ViewModel.ConnectedDevices}"
                        DisplayMemberPath="DisplayText"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />
                </StackPanel>
            </CommandBar.Content>

            <AppBarButton Label="New" Click="NewProfile_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Delete" Click="DeleteProfile_Click" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Save" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Activity" ToolTipService.ToolTip="Recent runtime events">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid Width="420" MaxHeight="340">
                            <TextBlock
                                Text="No runtime events yet."
                                Opacity="0.6"
                                Margin="4"
                                Visibility="{x:Bind ViewModel.HasNoRuntimeLog, Mode=OneWay}" />
                            <ListView ItemsSource="{x:Bind ViewModel.RuntimeLog}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" Opacity="0.85" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Label="Start"
                Command="{x:Bind ViewModel.ToggleRuntimeCommand}"
                IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Label="Stop"
                Command="{x:Bind ViewModel.ToggleRuntimeCommand}"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- First-run empty state -->
        <StackPanel
            Grid.Row="2"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="440"
            Visibility="{x:Bind ViewModel.HasNoProfiles, Mode=OneWay}">
            <Image Source="ms-appx:///Assets/Icons/joystick.png" Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Text="Set up your Stream Deck" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="A profile maps plugin commands to your device's keys. Create one, click a key on the grid, and pick what it should do."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="NewProfile_Click" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="Create your first profile" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="12" HorizontalAlignment="Left">
                    <!-- Deck face: the key grid sits on a dark rounded card that mirrors
                         the physical device. -->
                    <Border
                        x:Name="DeckCard"
                        Background="#FF1C1C1C"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        HorizontalAlignment="Left">
                        <StackPanel Spacing="10">
                            <GridView
                                x:Name="KeyGrid"
                                ItemsSource="{x:Bind ViewModel.Keys}"
                                SelectionMode="Single"
                                SelectionChanged="TargetList_SelectionChanged"
                                Loaded="KeyGrid_Loaded"
                                HorizontalAlignment="Left"
                                ItemTemplate="{StaticResource KeyTileTemplate}"
                                ItemContainerStyle="{StaticResource KeyTileContainerStyle}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>

                            <!-- Touch screen: a mappable target that can carry a background
                                 image and a command receiving tap events. -->
                            <GridView
                                x:Name="ScreenList"
                                ItemsSource="{x:Bind ViewModel.ScreenTargets}"
                                SelectionMode="Single"
                                SelectionChanged="TargetList_SelectionChanged"
                                ItemContainerStyle="{StaticResource KeyTileContainerStyle}"
                                Visibility="{x:Bind ViewModel.ShowScreenStrip, Mode=OneWay}"
                                HorizontalAlignment="Left">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyViewModel">
                                        <Grid Width="376" Height="44" CornerRadius="6" Background="#FF141414" BorderBrush="#FF333333" BorderThickness="1">
                                            <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Width="376" Height="44" Stretch="UniformToFill" />
                                            <TextBlock Text="Touch screen (select to configure)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#FFE8E8E8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <!-- Knobs: mappable targets; rotation and press events route to
                                 the mapped command. -->
                            <GridView
                                x:Name="KnobList"
                                ItemsSource="{x:Bind ViewModel.KnobTargets}"
                                SelectionMode="Single"
                                SelectionChanged="TargetList_SelectionChanged"
                                ItemContainerStyle="{StaticResource KeyTileContainerStyle}"
                                Visibility="{x:Bind ViewModel.ShowKnobs, Mode=OneWay}"
                                HorizontalAlignment="Center">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyViewModel">
                                        <StackPanel Width="94" Spacing="4" HorizontalAlignment="Center" Padding="0,4">
                                            <Ellipse Width="40" Height="40" Fill="#FF2B2B2B" Stroke="#FF4A4A4A" StrokeThickness="2" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind IndexLabel}" FontSize="10" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="10" Foreground="#FFE8E8E8" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="90" Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- Any-key commands: a compact list of mappings that fire on every
                         key press, edited through the same inspector. Usually zero or one. -->
                    <StackPanel
                        x:Name="AnyKeySection"
                        Spacing="4"
                        HorizontalAlignment="Left"
                        Width="{Binding ElementName=DeckCard, Path=ActualWidth, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                        <Grid Margin="4,4,0,0">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Any-key commands" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Run when any key on the deck is pressed." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.AddCatchAllCommand}"
                                AutomationProperties.Name="Add an any-key command">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="CatchAllList"
                            ItemsSource="{x:Bind ViewModel.CatchAllMappings}"
                            SelectionMode="Single"
                            SelectionChanged="TargetList_SelectionChanged"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="MinHeight" Value="40" />
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyViewModel">
                                    <TextBlock Text="{x:Bind TitleText, Mode=OneWay}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Key inspector: a seamless side pane on the page layer, separated by a
                 hairline divider, with a contextual header naming the selected target. -->
            <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="20,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,12,16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.InspectorTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.InspectorSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Command="{x:Bind ViewModel.ClearSelectedKeyCommand}"
                        Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}"
                        ToolTipService.ToolTip="Clear this key"
                        AutomationProperties.Name="Clear this key">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock
                            Text="Select a key on the grid to configure it."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoSelectedKey, Mode=OneWay}" />

                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}">
                            <ComboBox
                                Header="Plugin"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" />

                            <ComboBox
                                Header="Command"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AvailableCommands, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Button image" Style="{StaticResource BodyTextBlockStyle}" />
                                <Border Width="96" Height="96" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <Image Source="{x:Bind ViewModel.SelectedKey.PreviewImage, Mode=OneWay}" Width="96" Height="96" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedKey.ImageFileName, Mode=OneWay, FallbackValue=''}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedKey.ImagePath, Mode=OneWay, FallbackValue=''}"
                                    Visibility="{x:Bind ViewModel.SelectedKey.HasPreviewImage, Mode=OneWay, FallbackValue=Collapsed}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Browse" Click="BrowseKeyImage_Click" />
                                    <Button
                                        Content="Remove"
                                        Command="{x:Bind ViewModel.ClearSelectedKeyImageCommand}"
                                        Visibility="{x:Bind ViewModel.SelectedKey.HasPreviewImage, Mode=OneWay, FallbackValue=Collapsed}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Command settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="This command has no settings."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.7"
                                    Visibility="{x:Bind ViewModel.HasNoParameters, Mode=OneWay}" />
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.ParameterFields}"
                                    ItemTemplateSelector="{StaticResource ParameterTemplates}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
