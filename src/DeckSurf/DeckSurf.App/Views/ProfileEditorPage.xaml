<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeckSurf.App.Controls"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <!-- The image-picker key cap. The default Button hover swaps in the
             theme's control background, which turns the always-dark cap near
             white in light theme and drowns the dashed hint; instead, hover and
             press wash the cap with a faint DeckTextBrush overlay, so feedback
             reads as the key lighting up, identically in both themes. -->
        <Style x:Key="KeyCapPickerStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource DeckKeyBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverWash.Opacity" Value="0.08" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverWash.Opacity" Value="0.14" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Presenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Border
                                x:Name="HoverWash"
                                Background="{ThemeResource DeckTextBrush}"
                                Opacity="0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key tile: fills its 96px cell (88px visible inside the uniform 4px
             container margin) so selection chrome hugs the tile. Fill-only; the
             deck card's border is the only outline on the stage. -->
        <DataTemplate x:Key="KeyTileTemplate" x:DataType="vm:KeyViewModel">
            <Grid CornerRadius="8" Background="{ThemeResource DeckKeyBrush}">
                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                <!-- The live mirror of what the physical key is displaying right
                     now, drawn over the static profile image while a session runs. -->
                <Image Source="{x:Bind LiveImage, Mode=OneWay}" Stretch="UniformToFill" />
                <TextBlock
                    Text="{x:Bind Label, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource DeckTextBrush}"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    Margin="8,8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                <Border Background="{ThemeResource DeckFaceBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                    <TextBlock Text="{x:Bind IndexLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" />
                </Border>
                <!-- Selection ring: accent is the selection state's color, and the
                     ring reads unmistakably on the dark face. -->
                <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!-- The uniform 4px margin makes every gutter on the stage 8px and lands
             every element on one shared left edge 16px inside the card border. -->
        <Style x:Key="KeyTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Strips (touch screen, any-key) share one container: same margin, same
             radius, stretched content, no border. -->
        <Style x:Key="DeckStripContainerStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ParameterTextTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <TextBox
                    Header="{x:Bind HeaderText}"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterNumberTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <NumberBox
                    Header="{x:Bind HeaderText}"
                    Minimum="{x:Bind Minimum}"
                    Maximum="{x:Bind Maximum}"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    Value="{Binding NumberValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterBooleanTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <ToggleSwitch
                    Header="{x:Bind HeaderText}"
                    IsOn="{Binding BoolValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterChoiceTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <ComboBox
                    Header="{x:Bind HeaderText}"
                    PlaceholderText="Select…"
                    ItemsSource="{x:Bind Choices}"
                    SelectedItem="{Binding Value, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterFileTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <TextBlock Text="{x:Bind HeaderText}" Style="{StaticResource BodyTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse" Click="BrowseParameterFile_Click" />
                </Grid>
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <controls:ParameterTemplateSelector
            x:Key="ParameterTemplates"
            TextTemplate="{StaticResource ParameterTextTemplate}"
            NumberTemplate="{StaticResource ParameterNumberTemplate}"
            BooleanTemplate="{StaticResource ParameterBooleanTemplate}"
            ChoiceTemplate="{StaticResource ParameterChoiceTemplate}"
            FileTemplate="{StaticResource ParameterFileTemplate}"
            ImageTemplate="{StaticResource ParameterFileTemplate}" />
    </Page.Resources>

    <Grid Padding="28,20,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Editor" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
                <Button Click="NewProfile_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button Click="DeleteProfile_Click" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <!-- The runtime is automatic; Save is the page's primary action and
                     applies changes to the running device immediately. -->
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}"
                    ToolTipService.ToolTip="Save the profile and apply it to the device">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Title="Profile operation failed"
            Severity="Error"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Margin="0,24,0,0" />

        <!-- Scope row: which device is being edited, and which of its profiles. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,24,0,24" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
            <ComboBox
                MinWidth="240"
                Header="Device"
                PlaceholderText="No devices connected"
                IsEnabled="{x:Bind ViewModel.HasDevices, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.ConnectedDevices}"
                DisplayMemberPath="DisplayText"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
            <ComboBox
                MinWidth="200"
                Header="Profile"
                PlaceholderText="Select a profile"
                ItemsSource="{x:Bind ViewModel.ProfileNames}"
                SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />
        </StackPanel>

        <!-- First-run empty state -->
        <StackPanel
            Grid.Row="3"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="420"
            Visibility="{x:Bind ViewModel.HasNoProfiles, Mode=OneWay}">
            <Image Source="ms-appx:///Assets/Icons/joystick.png" Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Text="Set up your Stream Deck" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="A profile maps plugin commands to your device's keys. Create one, click a key on the grid, and pick what it should do."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Create your first profile"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Click="NewProfile_Click" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="24" Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Padding="0,0,0,24">
                <!-- Deck face: a dark card that mirrors the physical device. One
                     border (the card's own), one grid (the 96px key pitch), one
                     shared left edge for every element on the stage. Left-aligned
                     to the page rail like everything else. -->
                <Border
                    x:Name="DeckCard"
                    Background="{ThemeResource DeckFaceBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <StackPanel Spacing="0">
                        <GridView
                            x:Name="KeyGrid"
                            ItemsSource="{x:Bind ViewModel.Keys}"
                            SelectionMode="Single"
                            SelectionChanged="TargetList_SelectionChanged"
                            Loaded="KeyGrid_Loaded"
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource KeyTileTemplate}"
                            ItemContainerStyle="{StaticResource KeyTileContainerStyle}">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <!-- Touch screen: a mappable target that can carry a background
                             image and a command receiving tap events. -->
                        <ListView
                            x:Name="ScreenList"
                            ItemsSource="{x:Bind ViewModel.ScreenTargets}"
                            SelectionMode="Single"
                            SelectionChanged="TargetList_SelectionChanged"
                            ItemContainerStyle="{StaticResource DeckStripContainerStyle}"
                            Visibility="{x:Bind ViewModel.ShowScreenStrip, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Padding="0"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyViewModel">
                                    <Grid Height="44" CornerRadius="8" Background="{ThemeResource DeckKeyBrush}">
                                        <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Image Source="{x:Bind LiveImage, Mode=OneWay}" Stretch="Uniform" />
                                        <TextBlock Text="Touch screen (select to configure)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind TitleText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                                        <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Knobs: mappable targets on the same 96px pitch as the keys;
                             rotation and press events route to the mapped command. -->
                        <GridView
                            x:Name="KnobList"
                            ItemsSource="{x:Bind ViewModel.KnobTargets}"
                            SelectionMode="Single"
                            SelectionChanged="TargetList_SelectionChanged"
                            ItemContainerStyle="{StaticResource KeyTileContainerStyle}"
                            Visibility="{x:Bind ViewModel.ShowKnobs, Mode=OneWay}"
                            HorizontalAlignment="Left">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyViewModel">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center" Padding="0,4">
                                        <Grid HorizontalAlignment="Center">
                                            <Ellipse Width="48" Height="48" Fill="{ThemeResource DeckKeyBrush}" />
                                            <Ellipse Width="48" Height="48" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind IndexLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" Opacity="0.6" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="88" Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Any-key slot: same strip pattern as the touch screen.
                             Runs on every key press. -->
                        <ListView
                            x:Name="CatchAllList"
                            ItemsSource="{x:Bind ViewModel.CatchAllMappings}"
                            SelectionMode="Single"
                            SelectionChanged="TargetList_SelectionChanged"
                            ItemContainerStyle="{StaticResource DeckStripContainerStyle}"
                            HorizontalAlignment="Left"
                            Padding="0"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyViewModel">
                                    <Grid MinHeight="44" CornerRadius="8" Background="{ThemeResource DeckKeyBrush}">
                                        <TextBlock Text="Any key (runs on every press, select to configure)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind TitleText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource DeckTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                                        <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Key inspector: a grounded card on the same material as every other
                 card, with a contextual header naming the selected target. -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Padding="16"
                VerticalAlignment="Top"
                Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.InspectorTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.InspectorSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Content="Clear key"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.ClearSelectedKeyCommand}"
                            Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}"
                            AutomationProperties.Name="Clear this key" />
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <TextBlock
                                Text="Select a key on the grid to configure it."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasNoSelectedKey, Mode=OneWay}" />

                            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}">
                                <ComboBox
                                    Header="Plugin"
                                    PlaceholderText="Choose a plugin"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" />

                                <ComboBox
                                    Header="Command"
                                    PlaceholderText="Choose a command"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableCommands, Mode=OneWay}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" />

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowImageSection, Mode=OneWay}">
                                    <TextBlock Text="Button image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <!-- The key cap itself is the picker: an empty cap invites
                                         with a dashed outline, a filled cap shows the image, and
                                         clicking either opens the file picker. -->
                                    <Button
                                        Style="{StaticResource KeyCapPickerStyle}"
                                        Width="96"
                                        Height="96"
                                        HorizontalAlignment="Left"
                                        Click="BrowseKeyImage_Click"
                                        ToolTipService.ToolTip="Choose an image for this key"
                                        AutomationProperties.Name="Choose button image">
                                        <Grid Width="96" Height="96" CornerRadius="8">
                                            <Image Source="{x:Bind ViewModel.SelectedKey.PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                            <FontIcon
                                                Glyph="&#xE91B;"
                                                FontSize="20"
                                                Foreground="{ThemeResource DeckTextBrush}"
                                                Opacity="0.6"
                                                Visibility="{x:Bind ViewModel.SelectedKey.HasNoPreviewImage, Mode=OneWay, FallbackValue=Collapsed}" />
                                            <Rectangle
                                                Stroke="{ThemeResource DeckTextBrush}"
                                                Opacity="0.6"
                                                StrokeThickness="1"
                                                StrokeDashArray="3 3"
                                                RadiusX="8"
                                                RadiusY="8"
                                                Visibility="{x:Bind ViewModel.SelectedKey.HasNoPreviewImage, Mode=OneWay, FallbackValue=Collapsed}" />
                                        </Grid>
                                    </Button>
                                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SelectedKey.HasPreviewImage, Mode=OneWay, FallbackValue=Collapsed}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedKey.ImageFileName, Mode=OneWay, FallbackValue=''}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedKey.ImagePath, Mode=OneWay, FallbackValue=''}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Remove"
                                            Command="{x:Bind ViewModel.ClearSelectedKeyImageCommand}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Dynamic commands draw their own key face; say so instead of
                                     offering an image that would have no effect. -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowDynamicImageNote, Mode=OneWay}">
                                    <TextBlock Text="Button image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="This command draws its own button image."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasSelectedCommand, Mode=OneWay}">
                                    <TextBlock Text="Command settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="No settings. This command runs as-is."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind ViewModel.HasNoParameters, Mode=OneWay}" />
                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.ParameterFields}"
                                        ItemTemplateSelector="{StaticResource ParameterTemplates}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
