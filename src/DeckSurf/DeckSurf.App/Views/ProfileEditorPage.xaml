<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeckSurf.App.Controls"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ParameterTextTemplate" x:DataType="vm:ParameterFieldViewModel">
            <TextBox
                Header="{x:Bind DisplayName}"
                PlaceholderText="{x:Bind Description}"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterNumberTemplate" x:DataType="vm:ParameterFieldViewModel">
            <NumberBox
                Header="{x:Bind DisplayName}"
                PlaceholderText="{x:Bind Description}"
                Minimum="{x:Bind Minimum}"
                Maximum="{x:Bind Maximum}"
                SpinButtonPlacementMode="Inline"
                SmallChange="1"
                Value="{Binding NumberValue, Mode=TwoWay}"
                Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterBooleanTemplate" x:DataType="vm:ParameterFieldViewModel">
            <ToggleSwitch
                Header="{x:Bind DisplayName}"
                IsOn="{Binding BoolValue, Mode=TwoWay}"
                Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterChoiceTemplate" x:DataType="vm:ParameterFieldViewModel">
            <ComboBox
                Header="{x:Bind DisplayName}"
                PlaceholderText="{x:Bind Description}"
                ItemsSource="{x:Bind Choices}"
                SelectedItem="{Binding Value, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="ParameterFileTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="{x:Bind Description}"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse" Click="BrowseParameterFile_Click" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <controls:ParameterTemplateSelector
            x:Key="ParameterTemplates"
            TextTemplate="{StaticResource ParameterTextTemplate}"
            NumberTemplate="{StaticResource ParameterNumberTemplate}"
            BooleanTemplate="{StaticResource ParameterBooleanTemplate}"
            ChoiceTemplate="{StaticResource ParameterChoiceTemplate}"
            FileTemplate="{StaticResource ParameterFileTemplate}"
            ImageTemplate="{StaticResource ParameterFileTemplate}" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                MinWidth="200"
                PlaceholderText="Select a profile"
                ItemsSource="{x:Bind ViewModel.ProfileNames}"
                SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />

            <Button Grid.Column="1" Content="New" Click="NewProfile_Click" />
            <Button Grid.Column="2" Content="Delete" Click="DeleteProfile_Click" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />
            <Button Grid.Column="3" Content="Save" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />

            <Button
                Grid.Column="5"
                Content="{x:Bind FormatToggleLabel(ViewModel.IsRunning), Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleRuntimeCommand}"
                IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="12">
                    <GridView
                        x:Name="KeyGrid"
                        ItemsSource="{x:Bind ViewModel.Keys}"
                        SelectionMode="Single"
                        SelectionChanged="KeyGrid_SelectionChanged"
                        Loaded="KeyGrid_Loaded"
                        HorizontalAlignment="Left">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyViewModel">
                                <Grid Width="88" Height="88" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Width="88" Height="88" Stretch="UniformToFill" />
                                    <TextBlock
                                        Text="{x:Bind Label, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="6"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center" />
                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="4,1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                                        <TextBlock Text="{x:Bind IndexLabel}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="10" Opacity="0.8" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Expander Header="Catch-all mappings (run on every button press)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <ListView
                                x:Name="CatchAllList"
                                ItemsSource="{x:Bind ViewModel.CatchAllMappings}"
                                SelectionMode="Single"
                                SelectionChanged="CatchAllList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label, Mode=OneWay}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Remove" Click="RemoveCatchAll_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Add catch-all mapping" Command="{x:Bind ViewModel.AddCatchAllCommand}" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Runtime log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView ItemsSource="{x:Bind ViewModel.RuntimeLog}" MaxHeight="220" SelectionMode="None" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Expander
                Grid.Column="1"
                Header="Key configuration"
                IsExpanded="True"
                ExpandDirection="Down"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="720" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                <TextBlock
                    Text="Select a key on the grid to configure it."
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoSelectedKey, Mode=OneWay}" />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}">

                    <ComboBox
                        Header="Plugin"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Plugins}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" />

                    <ComboBox
                        Header="Command"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AvailableCommands, Mode=OneWay}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Button image (optional)" Style="{StaticResource BodyTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{x:Bind ViewModel.SelectedKey.PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedKey.ImagePath, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Browse" Click="BrowseKeyImage_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Command settings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock
                        Text="This command has no settings."
                        Opacity="0.7"
                        Visibility="{x:Bind ViewModel.HasNoParameters, Mode=OneWay}" />
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.ParameterFields}"
                        ItemTemplateSelector="{StaticResource ParameterTemplates}" />

                    <Button Content="Clear key" Command="{x:Bind ViewModel.ClearSelectedKeyCommand}" Margin="0,8,0,0" />
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Expander>
        </Grid>
    </Grid>
</Page>
