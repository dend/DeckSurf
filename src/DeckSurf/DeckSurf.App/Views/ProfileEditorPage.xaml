<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeckSurf.App.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeckSurf.App.Controls"
    xmlns:vm="using:DeckSurf.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="KeyTileTemplate" x:DataType="vm:KeyViewModel">
            <Grid Width="86" Height="86" CornerRadius="8" Background="#FF2B2B2B" BorderBrush="#FF3D3D3D" BorderThickness="1">
                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Width="86" Height="86" Stretch="UniformToFill" />
                <TextBlock
                    Text="{x:Bind Label, Mode=OneWay}"
                    Foreground="#FFE8E8E8"
                    FontSize="11"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    Margin="6,18,6,6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Visibility="{x:Bind ShowLabel, Mode=OneWay}" />
                <Border Background="#66000000" CornerRadius="4" Padding="5,1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                    <TextBlock Text="{x:Bind IndexLabel}" FontSize="10" Foreground="#B3FFFFFF" />
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="KeyTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ParameterTextTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <TextBox
                    Header="{x:Bind HeaderText}"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterNumberTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <NumberBox
                    Header="{x:Bind HeaderText}"
                    Minimum="{x:Bind Minimum}"
                    Maximum="{x:Bind Maximum}"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    Value="{Binding NumberValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterBooleanTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <ToggleSwitch
                    Header="{x:Bind HeaderText}"
                    IsOn="{Binding BoolValue, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterChoiceTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <ComboBox
                    Header="{x:Bind HeaderText}"
                    PlaceholderText="Select…"
                    ItemsSource="{x:Bind Choices}"
                    SelectedItem="{Binding Value, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterFileTemplate" x:DataType="vm:ParameterFieldViewModel">
            <StackPanel Margin="0,0,0,14" Spacing="4">
                <TextBlock Text="{x:Bind HeaderText}" Style="{StaticResource BodyTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse" Click="BrowseParameterFile_Click" />
                </Grid>
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>

        <controls:ParameterTemplateSelector
            x:Key="ParameterTemplates"
            TextTemplate="{StaticResource ParameterTextTemplate}"
            NumberTemplate="{StaticResource ParameterNumberTemplate}"
            BooleanTemplate="{StaticResource ParameterBooleanTemplate}"
            ChoiceTemplate="{StaticResource ParameterChoiceTemplate}"
            FileTemplate="{StaticResource ParameterFileTemplate}"
            ImageTemplate="{StaticResource ParameterFileTemplate}" />
    </Page.Resources>

    <Grid Padding="28,16,28,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox
                        MinWidth="180"
                        VerticalAlignment="Center"
                        PlaceholderText="Select a profile"
                        ItemsSource="{x:Bind ViewModel.ProfileNames}"
                        SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />
                    <ComboBox
                        MinWidth="220"
                        VerticalAlignment="Center"
                        PlaceholderText="Device"
                        ToolTipService.ToolTip="Device this profile targets"
                        ItemsSource="{x:Bind ViewModel.ConnectedDevices}"
                        DisplayMemberPath="DisplayText"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}" />
                </StackPanel>
            </CommandBar.Content>

            <AppBarButton Label="New" Click="NewProfile_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Delete" Click="DeleteProfile_Click" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Save" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Activity" ToolTipService.ToolTip="Recent runtime events">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid Width="420" MaxHeight="340">
                            <TextBlock
                                Text="No runtime events yet."
                                Opacity="0.6"
                                Margin="4"
                                Visibility="{x:Bind ViewModel.HasNoRuntimeLog, Mode=OneWay}" />
                            <ListView ItemsSource="{x:Bind ViewModel.RuntimeLog}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" Opacity="0.85" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Label="Start"
                Command="{x:Bind ViewModel.ToggleRuntimeCommand}"
                IsEnabled="{x:Bind ViewModel.HasProfile, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Label="Stop"
                Command="{x:Bind ViewModel.ToggleRuntimeCommand}"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="380" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="12" HorizontalAlignment="Left">
                    <!-- Deck face: the key grid sits on a dark rounded card that mirrors
                         the physical device. -->
                    <Border
                        Background="#FF1C1C1C"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        HorizontalAlignment="Left">
                        <StackPanel Spacing="10">
                            <GridView
                                x:Name="KeyGrid"
                                ItemsSource="{x:Bind ViewModel.Keys}"
                                SelectionMode="Single"
                                SelectionChanged="KeyGrid_SelectionChanged"
                                Loaded="KeyGrid_Loaded"
                                HorizontalAlignment="Left"
                                ItemTemplate="{StaticResource KeyTileTemplate}"
                                ItemContainerStyle="{StaticResource KeyTileContainerStyle}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>

                            <!-- Display-only hardware extras; mapping support comes later. -->
                            <Border
                                x:Name="ScreenStrip"
                                Height="44"
                                CornerRadius="6"
                                Background="#FF141414"
                                BorderBrush="#FF333333"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.ShowScreenStrip, Mode=OneWay}"
                                ToolTipService.ToolTip="Touch screen — mapping support coming soon">
                                <TextBlock Text="Touch screen" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="48"
                                Visibility="{x:Bind ViewModel.ShowKnobs, Mode=OneWay}"
                                ToolTipService.ToolTip="Knobs — mapping support coming soon">
                                <Ellipse Width="38" Height="38" Fill="#FF2B2B2B" Stroke="#FF4A4A4A" StrokeThickness="2" />
                                <Ellipse Width="38" Height="38" Fill="#FF2B2B2B" Stroke="#FF4A4A4A" StrokeThickness="2" />
                                <Ellipse Width="38" Height="38" Fill="#FF2B2B2B" Stroke="#FF4A4A4A" StrokeThickness="2" />
                                <Ellipse Width="38" Height="38" Fill="#FF2B2B2B" Stroke="#FF4A4A4A" StrokeThickness="2" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Any-key mappings live in the same visual language: tiles that run
                         on every key press, edited through the same inspector. -->
                    <Border
                        x:Name="AnyKeyCard"
                        Background="#FF1C1C1C"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10,14,14"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Any key — runs on every press" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <GridView
                                    x:Name="CatchAllList"
                                    ItemsSource="{x:Bind ViewModel.CatchAllMappings}"
                                    SelectionMode="Single"
                                    SelectionChanged="CatchAllList_SelectionChanged"
                                    ItemTemplate="{StaticResource KeyTileTemplate}"
                                    ItemContainerStyle="{StaticResource KeyTileContainerStyle}"
                                    VerticalAlignment="Center">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <Button
                                    Width="86"
                                    Height="86"
                                    Background="Transparent"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Command="{x:Bind ViewModel.AddCatchAllCommand}"
                                    ToolTipService.ToolTip="Add an any-key mapping">
                                    <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="#99FFFFFF" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Key inspector: fixed-width side panel with a collapse-to-rail toggle so
                 the layout never reflows with selection state. -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="InspectorTitle" Text="Key configuration" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Button
                            x:Name="InspectorToggle"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Click="ToggleInspector_Click"
                            ToolTipService.ToolTip="Collapse panel">
                            <FontIcon x:Name="InspectorToggleGlyph" Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="InspectorBody" Grid.Row="1">
                        <StackPanel Spacing="12" Margin="4,4,12,4">
                            <TextBlock
                                Text="Select a key on the grid to configure it."
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasNoSelectedKey, Mode=OneWay}" />

                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelectedKey, Mode=OneWay}">
                                <ComboBox
                                    Header="Plugin"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Plugins}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" />

                                <ComboBox
                                    Header="Command"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableCommands, Mode=OneWay}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{Binding SelectedCommand, Mode=TwoWay}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Button image (optional)" Style="{StaticResource BodyTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{x:Bind ViewModel.SelectedKey.PreviewImage, Mode=OneWay}" Width="48" Height="48" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBox Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedKey.ImagePath, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Browse" Click="BrowseKeyImage_Click" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearSelectedKeyImageCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="Remove image">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Command settings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                                <TextBlock
                                    Text="This command has no settings."
                                    Opacity="0.7"
                                    Visibility="{x:Bind ViewModel.HasNoParameters, Mode=OneWay}" />
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.ParameterFields}"
                                    ItemTemplateSelector="{StaticResource ParameterTemplates}" />

                                <Button Command="{x:Bind ViewModel.ClearSelectedKeyCommand}" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="Clear key" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
