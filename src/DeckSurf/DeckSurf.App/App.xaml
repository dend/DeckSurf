<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DeckSurf.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The backlit monogram legend on undeclared command caps: the user's
                 accent, doubly lightened so it stays legible on the always-dark key.
                 References the system accent ramp, never a literal color. -->
            <SolidColorBrush x:Key="DeckMonogramBrush" Color="{ThemeResource SystemAccentColorLight2}" />

            <!-- The deck face is deliberately dark in both themes: it mirrors the
                 physical hardware. These are the only literal colors in the app;
                 every other brush is a system ThemeResource. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DeckFaceBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="DeckKeyBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="DeckTextBrush" Color="#FFE8E8E8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DeckFaceBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="DeckKeyBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="DeckTextBrush" Color="#FFE8E8E8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
